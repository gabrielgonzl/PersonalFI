# =====================================================
# Growing Frontend - Environment Variables
# =====================================================

# =====================================================
# API Configuration
# =====================================================
# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Production example:
# VITE_API_BASE_URL=https://your-backend.railway.app/api/v1

# =====================================================
# Mock Data (Development)
# =====================================================
# Set to 'false' to use real backend API (recommended when backend is running)
# Set to 'true' to use mock data (useful when backend is not available)
VITE_USE_MOCK_DATA=false

# =====================================================
# App Configuration
# =====================================================
VITE_APP_NAME=Growing
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Personal Investment Tracker

# =====================================================
# Feature Flags (Future)
# =====================================================
# VITE_ENABLE_AUTH=false
# VITE_ENABLE_PRICE_UPDATES=false
# VITE_ENABLE_NOTIFICATIONS=false

# =====================================================
# Analytics (Future)
# =====================================================
# VITE_GA_TRACKING_ID=your_google_analytics_id
# VITE_SENTRY_DSN=your_sentry_dsn

# =====================================================
# External APIs (Future)
# =====================================================
# VITE_COINGECKO_API_URL=https://api.coingecko.com/api/v3
