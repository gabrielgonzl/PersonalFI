# =====================================================
# Growing Backend - Environment Variables
# =====================================================

# =====================================================
# Server Configuration
# =====================================================
NODE_ENV=development
PORT=5000

# =====================================================
# MongoDB Configuration
# =====================================================
# Get your MongoDB URI from MongoDB Atlas:
# 1. Go to https://cloud.mongodb.com/
# 2. Navigate to your cluster
# 3. Click "Connect" > "Connect your application"
# 4. Copy the connection string
# 5. Replace <password> with your database password
# 6. Replace <dbname> with "growing" or your preferred name

MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/growing?retryWrites=true&w=majority

# Alternative for local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/growing

# =====================================================
# CORS Configuration
# =====================================================
# Frontend URL (for CORS)
CORS_ORIGIN=http://localhost:5173

# Production example:
# CORS_ORIGIN=https://growing-app.vercel.app

# =====================================================
# Logging Configuration
# =====================================================
# Options: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=debug

# =====================================================
# API Configuration (Future)
# =====================================================
# Price update APIs (para futuro)
# COINGECKO_API_KEY=your_coingecko_api_key
# ALPHAVANTAGE_API_KEY=your_alphavantage_api_key

# =====================================================
# Security (Future - when implementing auth)
# =====================================================
# JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# JWT_EXPIRE=7d

# =====================================================
# Rate Limiting
# =====================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Yahoo Finance via RapidAPI (SteadyAPI)
# Get your API key from: https://rapidapi.com/steadyapi/api/yahoo-finance162
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=yahoo-finance162.p.rapidapi.com
